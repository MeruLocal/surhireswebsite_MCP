# Dependencies and build output — reinstalled and recompiled inside the image.
node_modules
dist
*.tsbuildinfo

# Version control and editor state
.git
.gitignore
.vscode
.idea

# Secrets — must never enter the build context
.env
.env.*
!.env.example
*.pem

# Logs and OS cruft
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Tests and tooling output — the image ships the server, not the suite.
tests
coverage

# Repo documentation and working files — not needed at runtime
README.md
claude_desktop_config.example.json

# Container files themselves
Dockerfile
.dockerignore
