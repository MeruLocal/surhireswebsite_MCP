# ---------------------------------------------------------------------------
# surhires-mcp configuration -- placeholders only, never commit a real .env
# ---------------------------------------------------------------------------
# This server reads ONLY Surhires' public marketing/content website.
# It needs no credentials, because Surhires publishes no API today
# (see README "Missing API capabilities"). There is deliberately no
# API key, token or cookie setting here: adding one would imply an
# authenticated surface that does not exist.

# Origin to read. Override only to point at a staging mirror you control.
SURHIRES_BASE_URL=https://surhires.com

# Market whose localised pages are read: in | us | gb | au
SURHIRES_MARKET=in

# HTTP behaviour
SURHIRES_TIMEOUT_MS=15000
SURHIRES_MAX_RETRIES=2
SURHIRES_MAX_CONCURRENCY=4
SURHIRES_CACHE_TTL_MS=900000
# Most pages held in the cache; least recently used are evicted first.
SURHIRES_CACHE_MAX_ENTRIES=500
# Outbound pages larger than this many bytes are refused, not read.
SURHIRES_MAX_PAGE_BYTES=5242880

# Contact string appended to the User-Agent so the site owner can identify
# this client and reach you. Use a Surhires address you monitor -- it is sent
# with every request and is visible to any proxy or log viewer on the way.
SURHIRES_CONTACT=you@example.com

# error | warn | info | debug  (logs go to stderr; stdout is reserved for MCP)
LOG_LEVEL=info

# Streamable HTTP transport (npm run start:http) -- not used by stdio/Claude Desktop
PORT=3000
MCP_HTTP_HOST=127.0.0.1

# Extra Host header values the HTTP transport accepts, comma-separated.
# Needed behind a proxy or in a container, where the Host is the published
# name rather than localhost; without it the server answers 403.
# "*" disables DNS-rebinding protection entirely -- trusted networks only.
MCP_ALLOWED_HOSTS=

# Browser Origins allowed to POST /mcp, comma-separated ("*" = any). Requests
# with no Origin header (non-browser MCP clients) are always accepted.
MCP_ALLOWED_ORIGINS=

# POST /mcp requests per minute per client. 0 disables the limiter.
MCP_RATE_LIMIT_PER_MIN=60

# Number of trusted reverse-proxy hops in front of this server (0 or unset =
# none). The rate limit keys on the Nth X-Forwarded-For entry from the right.
# Behind Cloudflare then Apache use 2 (or use mod_remoteip and 1). Without a
# proxy leave it unset, or a caller could pick its own key.
TRUST_PROXY=

# Most pages one HTTP tool call may fetch (deep search, detail=true lists).
MCP_HTTP_DEEP_MAX_PAGES=10

# Public https:// origin advertised on the status page and discovery document,
# e.g. https://mcp.surhires.com. Leave empty for local use.
MCP_PUBLIC_BASE_URL=
