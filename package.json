{
  "name": "surhires-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Surhires' public, crawl-permitted website content (features, integrations, pricing, comparisons, blog, product status).",
  "license": "MIT",
  "homepage": "https://surhires.com",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "surhires-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --experimental-test-coverage",
    "prepare": "npm run build",
    "test:only": "node scripts/run-tests.mjs",
    "test:live": "npm run build && node --test tests/live.test.ts",
    "check:brands": "node scripts/check-brands.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
